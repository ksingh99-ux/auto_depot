<section class="hero">
  <p class="hero-tag">Winnipeg's family auto parts shop since 2006</p>
  <h1>Auto parts for Manitoba drivers</h1>
  <p>Floor mats, wiper blades, winter gear and car care products, shipped anywhere in Canada.</p>
</section>

<%= render "filter_bar", filter: @filter %>

<div class="section-title">
  <h2>
    <% if @filter == "on_sale" %>
      On Sale
    <% elsif @filter == "new" %>
      New Arrivals (last 3 days)
    <% else %>
      All Products
    <% end %>
  </h2>
  <span><%= @products.total_count %> items</span>
</div>

<% if @products.any? %>
  <div class="product-grid">
    <%= render @products %>
  </div>
  <%= paginate @products %>
<% else %>
  <p class="empty">No products found.</p>
<% end %>
