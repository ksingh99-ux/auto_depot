<p><%= link_to "← Back to all products", root_path %></p>

<article class="product-detail">
  <p class="product-category"><%= @product.category.name %></p>
  <h1><%= @product.name %></h1>

  <% if @product.on_sale %>
    <span class="badge-sale">On Sale</span>
  <% end %>

  <p class="product-price"><%= number_to_currency(@product.price) %></p>
  <p><%= @product.description %></p>

  <p class="stock">
    <% if @product.stock_quantity.positive? %>
      In stock: <%= @product.stock_quantity %>
    <% else %>
      Out of stock
    <% end %>
  </p>
</article>
