<%= render "shared/breadcrumbs", crumbs: [["Home", root_path], [@product.category.name, category_path(@product.category)], [@product.name, nil]] %>

<article class="product-detail">
  <div class="detail-image">
    <%= render "products/image", product: @product %>
  </div>

  <p class="product-category"><%= link_to @product.category.name, category_path(@product.category) %></p>
  <h1><%= @product.name %></h1>

  <% if @product.on_sale %>
    <span class="badge-sale">On Sale</span>
  <% end %>

  <p class="product-price"><%= number_to_currency(@product.price) %></p>
  <p><%= @product.description %></p>

  <p class="stock">
    <% if @product.stock_quantity.positive? %>
      In stock: <%= @product.stock_quantity %>
    <% else %>
      Out of stock
    <% end %>
  </p>
  <%= render "products/add_to_cart", product: @product %>
</article>
