<%= render "shared/breadcrumbs", crumbs: [["Home", root_path], ["My Account", nil]] %>

<div class="form-card">
  <h1>My Account</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-row">
      <div class="field"><%= f.label :first_name %><%= f.text_field :first_name %></div>
      <div class="field"><%= f.label :last_name %><%= f.text_field :last_name %></div>
    </div>
    <div class="field"><%= f.label :email %><%= f.email_field :email %></div>

    <h3>Your address</h3>
    <div class="field"><%= f.label :address, "Street address" %><%= f.text_field :address %></div>
    <div class="form-row">
      <div class="field"><%= f.label :city %><%= f.text_field :city %></div>
      <div class="field"><%= f.label :postal_code %><%= f.text_field :postal_code %></div>
    </div>
    <div class="field">
      <%= f.label :province_id, "Province" %>
      <%= f.collection_select :province_id, Province.order(:name), :id, :name %>
    </div>

    <h3>Change password <small>(leave blank to keep it)</small></h3>
    <div class="form-row">
      <div class="field"><%= f.label :password, "New password" %><%= f.password_field :password, autocomplete: "new-password" %></div>
      <div class="field"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
    </div>

    <div class="field">
      <%= f.label :current_password %> <small>(needed to save changes)</small>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <%= f.submit "Save changes", class: "btn" %>
  <% end %>
</div>
