<%= render "shared/breadcrumbs", crumbs: [["Home", root_path], ["Cart", nil]] %>

<h1>Your Cart</h1>

<% if @cart_items.any? %>
  <table class="cart-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |item| %>
        <% product = item[:product] %>
        <tr>
          <td><%= link_to product.name, product %></td>
          <td><%= number_to_currency(product.price) %></td>
          <td>
            <%= form_with url: cart_item_path(product), method: :patch, class: "qty-form" do %>
              <%= number_field_tag :quantity, item[:quantity], min: 1, max: 99 %>
              <%= submit_tag "Update", name: nil, class: "btn btn-small btn-dark" %>
            <% end %>
          </td>
          <td><%= number_to_currency(product.price * item[:quantity]) %></td>
          <td>
            <%= button_to "Remove", cart_item_path(product), method: :delete, class: "btn btn-small" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="cart-subtotal">Subtotal: <strong><%= number_to_currency(@subtotal) %></strong></p>
  <%= link_to "Continue shopping", root_path, class: "btn" %>
<% else %>
  <p class="empty">Your cart is empty. <%= link_to "Start shopping", root_path %></p>
<% end %>
